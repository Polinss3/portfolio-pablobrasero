---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import Framed from "@/components/Framed.astro";
import { PROJECTS, ROOMS, STATUS_TONE, TINT, type Project } from "@/data/projects";

export function getStaticPaths() {
  return PROJECTS.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: PROJECTS[(i - 1 + PROJECTS.length) % PROJECTS.length],
      next: PROJECTS[(i + 1) % PROJECTS.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project: p, prev, next } = Astro.props;
const room = ROOMS.find((r) => r.id === p.room)!;
const tint = TINT[p.tint];
const tone = STATUS_TONE[p.status.tone];
const ogImage = p.art.kind === "image" ? p.art.src : undefined;
---

<Layout title={p.title} description={p.summary} image={ogImage}>
  <header class="page-head">
    <div>
      <p class="eyebrow">Sala {room.numeral} · {room.title}</p>
      <h1>{p.title}</h1>
    </div>
    <div class="page-head-right">
      <a href={`/galeria#${p.slug}`} class="chip"><Icon name="frame" />Verlo en la galería</a>
      <a href="/proyectos" class="round-btn" aria-label="Todos los proyectos"><Icon name="grid" /></a>
    </div>
  </header>

  <section class="bento">
    <div class="tile tile-lg detail-art col-span-2 lg:col-span-5" style={`--wash:${tint.bg}`}>
      <Framed project={p} eager class="detail-frame" />
    </div>

    <article class="tile tile-lg col-span-2 lg:col-span-7">
      <div class="tile-head">
        <span class="pill" style={`background:${tone.bg};color:${tone.fg}`}>{p.status.label}</span>
        <span class="tile-label">{p.year}</span>
      </div>
      <p class="font-display text-[28px] font-medium leading-tight tracking-tight">{p.kicker}</p>
      <p class="mt-3 text-[16px] leading-relaxed text-soft">{p.summary}</p>

      {
        p.stats && (
          <div class="mt-6 grid grid-cols-3 gap-3">
            {p.stats.map((s) => (
              <div class="rounded-[14px] px-4 py-3" style={`background:${tint.bg}`}>
                <p class="big-num text-[30px]" style={`color:${tint.fg}`}>{s.value}</p>
                <p class="mt-1.5 text-xs text-dim">{s.label}</p>
              </div>
            ))}
          </div>
        )
      }

      <div class="tile-foot mt-6 flex flex-wrap gap-2">
        {
          p.links.map((l, i) => (
            <a href={l.url} class:list={["btn", i === 0 ? "btn-primary" : "btn-ghost"]} target="_blank" rel="noopener">
              {l.label}
              <Icon name="arrow-up-right" />
            </a>
          ))
        }
        {p.links.length === 0 && <span class="text-sm text-dim">Proyecto sin enlace público.</span>}
      </div>
    </article>

    <article class="tile tile-lg col-span-2 lg:col-span-7">
      <div class="tile-head">
        <span class="tile-title">
          <span class="tile-icon" style={`background:${tint.bg};color:${tint.fg}`}><Icon name="layers" /></span>
          La obra
        </span>
      </div>
      <div class="prose-soft">
        {p.story.map((s) => <p>{s}</p>)}
      </div>
    </article>

    <div class="col-span-2 flex flex-col lg:col-span-5" style="gap: inherit">
      <article class="tile tile-lg">
        <div class="tile-head">
          <span class="tile-title">
            <span class="tile-icon" style={`background:${tint.bg};color:${tint.fg}`}><Icon name="sparkles" /></span>
            Detalles
          </span>
        </div>
        <ul class="space-y-2">
          {
            p.highlights.map((h) => (
              <li class="flex text-sm leading-relaxed text-soft">
                <span class="dot mr-3 mt-[7px]" style={`background:${tint.fg}`} />
                {h}
              </li>
            ))
          }
        </ul>
      </article>
      <article class="tile">
        <div class="tile-head">
          <span class="tile-label">Técnica</span>
          <span class="tile-label">{p.stack.length}</span>
        </div>
        <p class="mb-3 text-sm italic text-dim">{p.technique}</p>
        <div class="flex flex-wrap gap-1.5">
          {p.stack.map((s) => <span class="tag">{s}</span>)}
        </div>
      </article>
    </div>
  </section>

  {
    p.shots && (
      <>
        <div class="section-head">
          <div>
            <p class="eyebrow">Capturas</p>
            <h2>En la pantalla</h2>
          </div>
        </div>
        <section class:list={["shots", p.shotsLayout === "wide" ? "shots-wide" : "shots-phone"]}>
          {p.shots.map((src, i) => (
            <figure class="shot">
              <img src={src} alt={`${p.title}: captura ${i + 2}`} loading="lazy" decoding="async" />
            </figure>
          ))}
        </section>
      </>
    )
  }

  <nav class="mt-10 grid grid-cols-2 gap-3" aria-label="Otros proyectos">
    <a href={`/proyectos/${prev.slug}`} class="tile">
      <span class="tile-label flex items-center gap-1"><Icon name="arrow-left" size={14} />Anterior</span>
      <span class="mt-1 font-display text-[19px] font-medium">{prev.title}</span>
    </a>
    <a href={`/proyectos/${next.slug}`} class="tile items-end text-right">
      <span class="tile-label flex items-center gap-1">Siguiente<Icon name="arrow-right" size={14} /></span>
      <span class="mt-1 font-display text-[19px] font-medium">{next.title}</span>
    </a>
  </nav>
</Layout>

<style>
  .detail-art {
    align-items: center; justify-content: center; min-height: 380px; padding: 40px 28px;
    background: radial-gradient(ellipse 80% 70% at 50% 25%, #fffdf9, var(--wash));
  }
  .detail-art :global(.detail-frame.shape-tall),
  .detail-art :global(.detail-frame.shape-phone) { height: min(64vh, 560px); }
  .detail-art :global(.detail-frame.shape-wide) { width: 100%; max-width: 560px; }
  .detail-art :global(.detail-frame.shape-square) { width: 100%; max-width: 380px; }

  .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .shots-wide { grid-template-columns: minmax(0, 1fr); }
  .shot {
    overflow: hidden; border-radius: 18px; border: 1px solid var(--line); background: var(--panel); padding: 8px;
  }
  .shot img { display: block; width: 100%; height: auto; border-radius: 12px; }

  @media (max-width: 760px) {
    .detail-art { min-height: 0; padding: 28px 20px; }
    .detail-art :global(.detail-frame.shape-tall),
    .detail-art :global(.detail-frame.shape-phone) { height: min(56vh, 460px); }
    .shots-phone {
      grid-auto-flow: column; grid-auto-columns: 62%; grid-template-columns: none;
      overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none;
      margin: 0 -16px; padding: 0 16px 6px; scroll-padding: 0 16px;
    }
    .shots-phone::-webkit-scrollbar { display: none; }
    .shots-phone .shot { scroll-snap-align: start; }
  }
</style>
